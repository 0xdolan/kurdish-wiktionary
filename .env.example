# Copy to .env and adjust for local development.
#
# Host dev (uv): use localhost for DATABASE_URL.
# Docker Compose: api/worker override DATABASE_URL to host `postgres` — see docker-compose.yml.

# Host tools (DBeaver, uv): default Docker host port 5434 — see docs/DBeaver.md
DATABASE_URL=postgresql+asyncpg://wiktionary:wiktionary@127.0.0.1:5434/wiktionary
POSTGRES_HOST_PORT=5434
ZIM_PATH=./zim/wiktionary/wiktionary_ku_all_nopic_2026-06.zim
# Comma-separated list for canonical wordlist + dual-ZIM extract (Docker sets both archives)
ZIM_PATHS=./zim/wiktionary/wiktionary_ku_all_nopic_2026-06.zim,./zim/wiktionary/wiktionary_ku_all_maxi_2026-08.zim
DEFAULT_DATA_SOURCE=sql
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_RPM=120
LOG_LEVEL=INFO

MDX_WORK_DIR=./build/mdict
MDX_DEFAULT_TITLE=Wîkîferheng
MDX_BUILD_MAX_CONCURRENT=1
MDX_INCLUDE_MEDIA=true
