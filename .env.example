# Copy to .env and adjust for local development.
#
# Host dev (uv): use localhost for DATABASE_URL.
# Docker Compose: api/worker override DATABASE_URL to host `postgres` — see docker-compose.yml.

DATABASE_URL=postgresql+asyncpg://wiktionary:wiktionary@localhost:5432/wiktionary
ZIM_PATH=./zim/wiktionary/wiktionary_ku_all_nopic_2026-06.zim
DEFAULT_DATA_SOURCE=sql
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_RPM=120
LOG_LEVEL=INFO

MDX_WORK_DIR=./build/mdict
MDX_DEFAULT_TITLE=Wîkîferheng
MDX_BUILD_MAX_CONCURRENT=1
MDX_INCLUDE_MEDIA=true
